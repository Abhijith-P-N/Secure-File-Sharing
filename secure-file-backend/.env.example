NODE_ENV=development
PORT=8000

# PostgreSQL connection used by the backend from the host/dev machine.
# Inside Docker the backend is given a host name of `db` automatically.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/secure_files

# Generate: openssl rand -hex 64
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h

# Refresh-token rotation (issued at login/refresh, revoked on rotation/logout)
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_BYTES=32

# Generate a 32-byte key for AES-256-GCM: openssl rand -hex 32
FILE_ENCRYPTION_KEY=change_me

CORS_ORIGIN=http://localhost:5173
# Maximum upload size in MB (2 GB default = 2048 MB)
MAX_FILE_SIZE_MB=2048
UPLOAD_DIR=./uploads
# Random bytes used to generate share tokens (32 => 256-bit entropy)
SHARE_TOKEN_BYTES=32

# Admin seeding (run `npm run seed:admin`)
ADMIN_EMAIL=admin@secure-share.local
ADMIN_PASSWORD=ChangeMe_Admin_2026

# ----------------------------------------------------------------------------
# SMTP / Email (used for verification codes, password resets, share emails).
# Leave unset to run without real email — codes are then logged to the console.
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# For port 465 use SMTP_PORT=465 (TLS). For Gmail, use an app password, not your
# account password. Generate at https://myaccount.google.com/apppasswords
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password
# Optional — defaults to the SMTP_USER if omitted.
SMTP_FROM="VaultGuard <noreply@vaultguard.local>"