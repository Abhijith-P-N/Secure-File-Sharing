# ============================================================================
# Secure File Sharing Platform - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
#
# NOTE: This file documents the SHARED variables. Each app has its own:
#   backend:  secure-file-backend/.env.example
#   frontend: frontend/.env.example
# The frontend is a static build and uses VITE_* variables only.
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=8000

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Connection string used by the backend from the host/dev machine.
# Inside Docker the backend is given a host name of `db` automatically.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/secure_files
POSTGRES_DB=secure_files
POSTGRES_USER=app_user
# Dev-only default. Generate a strong one: openssl rand -hex 32
POSTGRES_PASSWORD=app_password
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Generate: openssl rand -hex 64
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h

# Refresh-token rotation (issued at login/refresh, revoked on rotation/logout)
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_BYTES=32

# ----------------------------------------------------------------------------
# File encryption (AES-256-GCM)
# ----------------------------------------------------------------------------
# Generate a 32-byte key: openssl rand -hex 32
FILE_ENCRYPTION_KEY=change_me

# ----------------------------------------------------------------------------
# Frontend / CORS
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
# Maximum upload size in MB (10 MB default)
MAX_FILE_SIZE_MB=10
# Random bytes used to generate share tokens (32 => 256-bit entropy)
SHARE_TOKEN_BYTES=32

# ----------------------------------------------------------------------------
# Admin seeding (run: cd secure-file-backend && npm run seed:admin)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@secure-share.local
ADMIN_PASSWORD=ChangeMe_Admin_2026

# ----------------------------------------------------------------------------
# Production / HTTPS (deployment only - see database1/docs/DEPLOYMENT.md)
# ----------------------------------------------------------------------------
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com