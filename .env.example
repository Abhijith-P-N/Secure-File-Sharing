# ============================================================================
# Secure File Sharing Platform - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=8000

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Connection string used by the backend from the host/dev machine.
# Inside Docker the backend is given a host name of `db` automatically.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/secure_files
POSTGRES_DB=secure_files
POSTGRES_USER=app_user
# Dev-only default. Generate a strong one: openssl rand -hex 32
POSTGRES_PASSWORD=app_password
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Authentication (Azin owns the auth code; these are the variables it uses)
# ----------------------------------------------------------------------------
# Generate: openssl rand -hex 64
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# File encryption (Adhil owns the crypto code; these are the variables it uses)
# ----------------------------------------------------------------------------
# Generate a 32-byte key for AES-256-GCM: openssl rand -hex 32
ENCRYPTION_KEY=change_me
# Identifier stored inside files.encryption_metadata - NEVER store the key itself.
ENCRYPTION_KEY_ID=key-001

# ----------------------------------------------------------------------------
# Frontend / CORS
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
STORAGE_PATH=./storage
# Maximum upload size in bytes (100 MB default)
MAX_FILE_SIZE=104857600

# ----------------------------------------------------------------------------
# Production / HTTPS (deployment only - see docs/DEPLOYMENT.md)
# ----------------------------------------------------------------------------
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com