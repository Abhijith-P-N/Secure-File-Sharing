# API base URL used by the built SPA.
# Leave EMPTY (or unset) to use relative same-origin /api paths, which:
#   - prod (nginx/Render): proxies /api to the backend via nginx
#   - dev (Vite): proxied to http://localhost:8000 by vite.config.js
# Set this ONLY if the backend is served from a different absolute origin.
VITE_API_BASE_URL=
